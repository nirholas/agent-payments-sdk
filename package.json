{
  "name": "@nirholas/agent-payments-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for Pump Agent Payments on Solana, with EVM payment helpers and x402 clients",
  "publishConfig": {
    "access": "public"
  },
  "author": "Pump Fun",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./evm": {
      "import": {
        "types": "./dist/evm/index.d.ts",
        "default": "./dist/evm/index.js"
      },
      "require": {
        "types": "./dist/evm/index.d.cts",
        "default": "./dist/evm/index.cjs"
      }
    },
    "./evm/index": {
      "import": {
        "types": "./dist/evm/index.d.ts",
        "default": "./dist/evm/index.js"
      },
      "require": {
        "types": "./dist/evm/index.d.cts",
        "default": "./dist/evm/index.cjs"
      }
    },
    "./solana": {
      "import": {
        "types": "./dist/solana/index.d.ts",
        "default": "./dist/solana/index.js"
      },
      "require": {
        "types": "./dist/solana/index.d.cts",
        "default": "./dist/solana/index.cjs"
      }
    },
    "./solana/index": {
      "import": {
        "types": "./dist/solana/index.d.ts",
        "default": "./dist/solana/index.js"
      },
      "require": {
        "types": "./dist/solana/index.d.cts",
        "default": "./dist/solana/index.cjs"
      }
    },
    "./solana/legacy-agent-payments": {
      "import": {
        "types": "./dist/solana/legacy-agent-payments/index.d.ts",
        "default": "./dist/solana/legacy-agent-payments/index.js"
      },
      "require": {
        "types": "./dist/solana/legacy-agent-payments/index.d.cts",
        "default": "./dist/solana/legacy-agent-payments/index.cjs"
      }
    },
    "./solana/legacy-agent-payments/index": {
      "import": {
        "types": "./dist/solana/legacy-agent-payments/index.d.ts",
        "default": "./dist/solana/legacy-agent-payments/index.js"
      },
      "require": {
        "types": "./dist/solana/legacy-agent-payments/index.d.cts",
        "default": "./dist/solana/legacy-agent-payments/index.cjs"
      }
    },
    "./solana/solana-agent-kit": {
      "import": {
        "types": "./dist/solana/solana-agent-kit/index.d.ts",
        "default": "./dist/solana/solana-agent-kit/index.js"
      },
      "require": {
        "types": "./dist/solana/solana-agent-kit/index.d.cts",
        "default": "./dist/solana/solana-agent-kit/index.cjs"
      }
    },
    "./solana/solana-agent-kit/index": {
      "import": {
        "types": "./dist/solana/solana-agent-kit/index.d.ts",
        "default": "./dist/solana/solana-agent-kit/index.js"
      },
      "require": {
        "types": "./dist/solana/solana-agent-kit/index.d.cts",
        "default": "./dist/solana/solana-agent-kit/index.cjs"
      }
    },
    "./x402": {
      "import": {
        "types": "./dist/x402/index.d.ts",
        "default": "./dist/x402/index.js"
      },
      "require": {
        "types": "./dist/x402/index.d.cts",
        "default": "./dist/x402/index.cjs"
      }
    },
    "./x402/index": {
      "import": {
        "types": "./dist/x402/index.d.ts",
        "default": "./dist/x402/index.js"
      },
      "require": {
        "types": "./dist/x402/index.d.cts",
        "default": "./dist/x402/index.cjs"
      }
    },
    "./solana-agent-kit": {
      "import": {
        "types": "./dist/solana/solana-agent-kit/index.d.ts",
        "default": "./dist/solana/solana-agent-kit/index.js"
      },
      "require": {
        "types": "./dist/solana/solana-agent-kit/index.d.cts",
        "default": "./dist/solana/solana-agent-kit/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:prod": "tsup --minify",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src eslint.config.js tsup.config.ts vitest.config.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "watch:usdc": "node scripts/usdc-whitelist-monitor.mjs",
    "check:whitelist": "node scripts/check-whitelist.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "solana",
    "pump-fun",
    "agent-payments",
    "x402",
    "evm",
    "cross-chain",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/agent-payments-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/nirholas/agent-payments-sdk/issues"
  },
  "homepage": "https://github.com/nirholas/agent-payments-sdk#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@pump-fun/pump-sdk": "^4.0.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.3",
    "viem": "^2.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pump-fun/agent-payments-sdk-legacy": "npm:@pump-fun/agent-payments-sdk@1.0.7",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "bigint-buffer": "file:vendor/bigint-buffer",
    "eslint": "^10.15.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@vitest/mocker@>=4.1.11 <4.1.12": "^4.1.12",
    "@vitest/mocker@>=2.1.0-beta.7.0.0 <4.1.12": "^4.1.12",
    "toml@<=5.0.0": "^5.0.1",
    "toml@<4.2.0": "^5.0.1",
    "toml@<4.1.2": "^5.0.1",
    "stream-json@<=3.5.0": "^3.6.0",
    "stream-json@<3.6.0": "^3.6.0",
    "stream-json@<=3.4.0": "^3.6.0",
    "ws@>=8.0.0 <8.21.0": "^8.21.0",
    "ws@>=7.0.0 <7.5.11": "^7.5.11",
    "ws@>=8.0.0 <8.20.1": "^8.21.0",
    "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
    "uuid@<11.1.1": "^11.1.1",
    "bigint-buffer": "$bigint-buffer"
  }
}
